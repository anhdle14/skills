{
  "tasks": {
    "install": "deno run --allow-read --allow-write --allow-env=HOME install.ts",
    "install:copy": "deno run --allow-read --allow-write --allow-env=HOME install.ts --copy-to",
    "update-index": "deno run --allow-read --allow-write --allow-env=HOME install.ts --update-index",
    "check": "deno check install.ts scripts/validate-skills.ts",
    "validate": "deno run --allow-read scripts/validate-skills.ts"
  },
  "imports": {
    "@std/cli": "jsr:@std/cli@^1.0.0",
    "@std/fs": "jsr:@std/fs@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0"
  }
}
